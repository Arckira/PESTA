# Arquivo .env para configuração local
# Substitua conforme necessário. Linha alterada por solicitação do utilizador.
DATABASE_URL=mssql+pyodbc://localhost\SQLEXPRESS/Industrial Testing LabDB?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes
# Duração do token de sessão em minutos.
# 600 min = 10h — margem de segurança para turnos industriais.
ACCESS_TOKEN_EXPIRE_MINUTES=600
