# URL de ligação à base de dados (ex: sqlite:///./testing_centre.db ou postgresql://user:pass@host/db)
DATABASE_URL=

# Origens permitidas pelo CORS, separadas por vírgula (ex: http://localhost:5173)
CORS_ORIGINS=

# Duração do token de acesso JWT em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=

# Ativar log SQL do SQLAlchemy (true/false)
SQL_ECHO=

# Tamanho base do pool de ligações à BD
DB_POOL_SIZE=

# Ligações extra permitidas acima do pool base
DB_MAX_OVERFLOW=

# Porto em que o servidor FastAPI escuta (usado pelo Vite como proxy)
VITE_API_PORT=

# Porto em que o servidor de desenvolvimento do Vite escuta
VITE_FRONTEND_PORT=

# Minutos de inatividade antes de terminar a sessão do utilizador no frontend
VITE_INATIVIDADE_MINUTOS=
