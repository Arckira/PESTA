# Base de dados
# DATABASE_URL=mssql+pyodbc://user:pass@server/db?driver=ODBC+Driver+17+for+SQL+Server
SQL_ECHO=false

# CORS — origens aceites pelo backend (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pool de ligações (apenas relevante com SQL Server)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
